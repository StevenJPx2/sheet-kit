{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adeptmind.dev/sheet-kit/manifest.v1.json",
  "title": "sheet-kit manifest (v1)",
  "description": "Resolved sheet spec emitted by `data`, rendered by `sheet-kit` with no domain knowledge. Capped at primitives actually used (manifest scope discipline). Add a primitive only when a real sheet needs it.",
  "type": "object",
  "required": ["contract_version", "spreadsheet_id", "tabs"],
  "additionalProperties": false,
  "properties": {
    "contract_version": { "const": 1 },
    "spreadsheet_id": { "type": "string", "minLength": 1 },
    "tabs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/tab" }
    }
  },
  "$defs": {
    "tab": {
      "type": "object",
      "required": ["name", "data_key", "columns"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "data_key": {
          "type": "string",
          "description": "Key into data.json.datasets selecting the rows for this tab."
        },
        "columns": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/column" } },
        "header_row": { "type": "integer", "minimum": 1, "description": "Number of header rows before data (default 1). Merges/charts anchor to this." },
        "freeze": { "$ref": "#/$defs/freeze" },
        "header_merges": { "type": "array", "items": { "$ref": "#/$defs/merge" } },
        "number_formats": { "type": "array", "items": { "$ref": "#/$defs/numberFormat" } },
        "row_label_styles": { "type": "array", "items": { "$ref": "#/$defs/rowLabelStyle" } },
        "text_rules": { "type": "array", "items": { "$ref": "#/$defs/textRule" } },
        "column_widths": { "type": "array", "items": { "$ref": "#/$defs/columnWidth" } },
        "gradients": { "type": "array", "items": { "$ref": "#/$defs/gradient" } },
        "charts": { "type": "array", "items": { "$ref": "#/$defs/chart" } }
      }
    },
    "column": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "description": "Stable UNIQUE column id; formulas reference it as {name} and sheet-kit resolves A1 at render (kills off-by-one bugs)." },
        "header": { "type": "string", "description": "Optional display header shown in the sheet; defaults to `name`. Use when several columns share a display label (e.g. repeated 'Lift % vs C20' across metric groups) but need unique names for formula refs." },
        "type": { "enum": ["string", "number", "integer", "money", "percent", "date", "hour"] },
        "source_field": { "type": "string", "description": "Field on the data row to pull the value from. Mutually exclusive with `formula`." },
        "formula": { "type": "string", "description": "Name-based formula, e.g. `={Revenue}/{Sessions}`. sheet-kit resolves {Name} to A1 refs per row." },
        "bold": { "type": "boolean", "description": "Bold this column's data cells." }
      }
    },
    "freeze": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "rows": { "type": "integer", "minimum": 0 }, "cols": { "type": "integer", "minimum": 0 } }
    },
    "merge": {
      "type": "object",
      "required": ["from", "to", "label"],
      "additionalProperties": false,
      "properties": { "from": { "type": "string" }, "to": { "type": "string" }, "label": { "type": "string" } }
    },
    "numberFormat": {
      "type": "object",
      "required": ["column", "format"],
      "additionalProperties": false,
      "properties": {
        "column": { "type": "string", "description": "Column name; resolved to a 1-based index at render." },
        "format": { "type": "string", "description": "Sheets number format, e.g. `$0.00`, `0.00%`, `#,##0`, `yyyy-mm-dd`." }
      }
    },
    "rowLabelStyle": {
      "type": "object",
      "required": ["match", "style"],
      "additionalProperties": false,
      "description": "Content-driven row styling: scan a label column, style matching rows. Survives section shifts (no hard-coded row numbers).",
      "properties": {
        "match": { "$ref": "#/$defs/labelMatch" },
        "style": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bold": { "type": "boolean" },
            "background": { "type": "string" },
            "font_color": { "type": "string" },
            "font_size": { "type": "integer" },
            "merge": { "type": "boolean" },
            "row_height": { "type": "integer" }
          }
        }
      }
    },
    "labelMatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "column": { "type": "string", "description": "Label column name (default first column)." },
        "prefix": { "type": "string" },
        "suffix": { "type": "string" },
        "equals": { "type": "string" }
      }
    },
    "textRule": {
      "type": "object",
      "required": ["equals", "color"],
      "additionalProperties": false,
      "description": "Whole-range text-equals background rule, e.g. PASS→green. Domain-agnostic; the strings come from the manifest.",
      "properties": {
        "equals": { "type": "string" },
        "color": { "type": "string" }
      }
    },
    "columnWidth": {
      "type": "object",
      "required": ["column", "width"],
      "additionalProperties": false,
      "properties": { "column": { "type": "string" }, "width": { "type": "integer", "minimum": 1 } }
    },
    "gradient": {
      "type": "object",
      "required": ["column", "kind"],
      "additionalProperties": false,
      "properties": {
        "column": { "type": "string" },
        "kind": { "enum": ["number", "percent", "percentile", "min", "max"] },
        "min_color": { "type": "string" },
        "mid_color": { "type": "string" },
        "max_color": { "type": "string" },
        "min_value": { "type": ["number", "string"] },
        "mid_value": { "type": ["number", "string"] },
        "max_value": { "type": ["number", "string"] }
      }
    },
    "chart": {
      "type": "object",
      "required": ["type", "x", "series"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "line" },
        "title": { "type": "string" },
        "x": { "type": "string", "description": "Column name for the X axis." },
        "series": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Column names plotted as series." },
        "num_headers": { "type": "integer", "minimum": 0 },
        "v_axis_format": { "type": "string" },
        "colors": { "type": "array", "items": { "type": "string" } },
        "width": { "type": "integer" },
        "height": { "type": "integer" },
        "position": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "row": { "type": "integer" }, "col": { "type": "integer" } }
        }
      }
    }
  }
}

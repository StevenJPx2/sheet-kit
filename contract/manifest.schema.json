{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adeptmind.dev/sheet-kit/manifest.v1.json",
  "title": "sheet-kit manifest (v1)",
  "description": "Resolved sheet spec emitted by `data`, rendered by `sheet-kit` with no domain knowledge. Capped at primitives actually used (manifest scope discipline). Add a primitive only when a real sheet needs it.",
  "type": "object",
  "required": ["contract_version", "spreadsheet_id", "tabs"],
  "additionalProperties": false,
  "properties": {
    "contract_version": { "const": 1 },
    "spreadsheet_id": { "type": "string", "minLength": 1 },
    "tabs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/tab" }
    }
  },
  "$defs": {
    "tab": {
      "type": "object",
      "required": ["name", "data_key", "columns"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "data_key": {
          "type": "string",
          "description": "Key into data.json.datasets selecting the rows for this tab."
        },
        "columns": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/column" } },
        "freeze": { "$ref": "#/$defs/freeze" },
        "header_merges": { "type": "array", "items": { "$ref": "#/$defs/merge" } },
        "section_rules": { "type": "array", "items": { "$ref": "#/$defs/sectionRule" } },
        "gradients": { "type": "array", "items": { "$ref": "#/$defs/gradient" } },
        "charts": { "type": "array", "items": { "$ref": "#/$defs/chart" } }
      }
    },
    "column": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "description": "Stable column name; A1 letters are resolved by sheet-kit at render time (kills off-by-one bugs)." },
        "type": { "enum": ["string", "number", "integer", "money", "percent", "date", "hour"] },
        "source_field": { "type": "string", "description": "Field on the data row to pull the value from. Mutually exclusive with `formula`." },
        "formula": { "type": "string", "description": "Name-based formula, e.g. `={Revenue}/{Sessions}`. sheet-kit resolves {Name} to A1 refs per row." }
      }
    },
    "freeze": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "rows": { "type": "integer", "minimum": 0 }, "cols": { "type": "integer", "minimum": 0 } }
    },
    "merge": {
      "type": "object",
      "required": ["from", "to", "label"],
      "additionalProperties": false,
      "properties": { "from": { "type": "string" }, "to": { "type": "string" }, "label": { "type": "string" } }
    },
    "sectionRule": {
      "type": "object",
      "required": ["match", "style"],
      "additionalProperties": false,
      "properties": {
        "match": { "$ref": "#/$defs/labelMatch" },
        "style": { "enum": ["section-header", "subtotal", "muted"] }
      }
    },
    "labelMatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "column": { "type": "string" }, "prefix": { "type": "string" }, "suffix": { "type": "string" } }
    },
    "gradient": {
      "type": "object",
      "required": ["column", "kind"],
      "additionalProperties": false,
      "properties": {
        "column": { "type": "string" },
        "kind": { "enum": ["number", "percentile"] },
        "min_color": { "type": "string" },
        "mid_color": { "type": "string" },
        "max_color": { "type": "string" }
      }
    },
    "chart": {
      "type": "object",
      "required": ["type", "x", "series"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "line" },
        "title": { "type": "string" },
        "x": { "type": "string", "description": "Column name for the X axis." },
        "series": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Column names plotted as series." }
      }
    }
  }
}
